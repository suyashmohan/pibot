NEXT_PUBLIC_APP_NAME="PiBot"
# SQLite file used by drizzle (better-sqlite3). Relative paths resolve from process.cwd().
DATABASE_URL="file:./data/pibot.db"
# Absolute path (or bare name on PATH) for the pi binary that serves --mode rpc.
PI_BINARY="pi"
# Default working directory spawned pi processes run in (where read/write/bash tools operate).
# Defaults to process.cwd() when unset.
# PI_DEFAULT_CWD="/Users/suyash/Documents/suyash/playground"
# Extra default args for every `pi --mode rpc` spawn (space-separated), e.g. "--provider google".
# PI_EXTRA_ARGS=""
# Timeout for RPC request/response round-trips in ms.
# PI_RPC_TIMEOUT_MS="120000"
